# Copy to .env for local runs. On Vercel, set these as project environment variables instead.

# Bhashini (Dhruva) inference key. Locally you can point at bhashini_kit's config file instead:
# BHASHINI_CONF=/path/to/bhashini_kit/config/bhashini.conf
BHASHINI_API_KEY=

# Gates every /api and /v1 call. Leave empty locally if you like; always set it on Vercel.
PLAYGROUND_ACCESS_CODE=

# Postgres for the core store. Empty locally = a SQLite file in data/local/.
DATABASE_URL=

# Vercel Blob for uploaded registers. Empty locally = files in data/local/uploads/.
BLOB_READ_WRITE_TOKEN=
# private (default) or public: must match how the Blob store was created.
BLOB_ACCESS=private

# Optional: a Google service-account key (the whole JSON on one line) for reading private Google Sheets.
GOOGLE_SERVICE_ACCOUNT=

# Used from M2 on.
NVIDIA_API_KEY=

# Optional: Redis for a didi's conversation memory across logins. Empty = earlier turns from the core store.
# REDIS_URL=redis://localhost:6379/0

# Admin sign-in on the login page: views any didi's chat and draws charts from her registers (every read is logged).
# Locally, leave the password empty and one is generated into data/local/admin.json. Always set it on Vercel.
# PLAYGROUND_ADMIN_USER=admin
# PLAYGROUND_ADMIN_PASSWORD=

# Optional, local only: report server and browser errors to a Sentry-compatible server (GlitchTip at
# http://localhost:8020, see the README). Ignored on Vercel and in tests.
# SENTRY_DSN=http://<key>@localhost:8020/1
