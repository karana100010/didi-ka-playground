# Copy to .env for local runs. On Vercel, set these as project environment variables instead.

# Bhashini (Dhruva) inference key. Locally you can point at bhashini_kit's config file instead:
# BHASHINI_CONF=/path/to/bhashini_kit/config/bhashini.conf
BHASHINI_API_KEY=

# Gates every /api and /v1 call. Leave empty locally if you like; always set it on Vercel.
PLAYGROUND_ACCESS_CODE=

# Postgres for the core store. Empty locally = a SQLite file in data/local/.
DATABASE_URL=

# Vercel Blob for uploaded registers. Empty locally = files in data/local/uploads/.
BLOB_READ_WRITE_TOKEN=
# private (default) or public: must match how the Blob store was created.
BLOB_ACCESS=private

# Optional: a Google service-account key (the whole JSON on one line) for reading private Google Sheets.
GOOGLE_SERVICE_ACCOUNT=

# Used from M2 on.
NVIDIA_API_KEY=
